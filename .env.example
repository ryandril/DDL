# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Canvas (required) ---------------------------------------------------
# Your school's Canvas host, no trailing slash.
CANVAS_BASE_URL=https://canvas.example.edu

# Canvas → Account → Settings → Approved Integrations → + New Access Token.
# Canvas displays the token exactly once; copy it immediately.
CANVAS_TOKEN=paste_your_canvas_personal_access_token_here

# IANA timezone name. Extracted deadlines are stamped with this zone.
TIMEZONE=Asia/Shanghai

# --- Labelling (optional) ------------------------------------------------
# Prefix on the digest subject and push message, e.g. "[Canvas] 2 deadlines".
# DIGEST_LABEL=Canvas
# Name of the Google Calendar to create/sync into.
# CALENDAR_NAME=Canvas Deadlines

# --- Canvas network (optional) -------------------------------------------
# Set to 1 only if your network requires the system proxy to reach Canvas.
# CANVAS_USE_SYSTEM_PROXY=1

# --- Ambiguous numeric dates (optional) ----------------------------------
# How to read "5/6": MDY (May 6, default) or DMY (5 June). Unambiguous dates
# like 15/05 resolve themselves either way.
# DATE_ORDER=MDY

# --- Google Calendar (optional) ------------------------------------------
# Calendar sync drives the `gog` CLI, which holds its own Google auth — there
# is no credential to configure here. Set GOG_BIN only if gog is not on PATH;
# cron's PATH usually excludes /usr/local/bin. See README section 3.
# GOG_BIN=/usr/local/bin/gog

# --- Runner (optional) ---------------------------------------------------
# cron_ddl.sh finds its own directory; set this only to override it.
# DDL_DIR=/path/to/ddl

# Your PRIMARY notification channel: any command that delivers out/subject.txt
# and out/digest.txt. Leave it unset to use email alone.
# NOTIFY_CMD=python3 /path/to/ddl/my_notifier.py

# --- Email fallback ------------------------------------------------------
# Used when NOTIFY_CMD is unset or fails, so a run never leaves you uninformed.
# Plain stdlib SMTP — no extra dependency. Set SMTP_HOST and EMAIL_TO to turn
# it on; with neither set, the run logs that it delivered nothing.
# For Gmail, SMTP_PASS must be an app password, not your account password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your_app_password
# EMAIL_FROM=you@gmail.com          # defaults to SMTP_USER
# EMAIL_TO=you@gmail.com            # comma-separated for several recipients
# SMTP_STARTTLS=1                   # set 0 only for a server that forbids it

# --- send_wechat_alert.py (optional, author's own notifier) --------------
# Only needed if NOTIFY_CMD points at send_wechat_alert.py. Requires OpenClaw
# and the `gog` Google CLI — see the Notifications section of the README.
# GOG_ACCOUNT=you@example.com          # Gmail account gog sends as
# ALERT_EMAIL_TO=you@example.com       # where failure alerts land
# WECHAT_ACCOUNT=                      # OpenClaw weixin account id
# WECHAT_TARGET=                       # OpenClaw weixin target id
# WHATSAPP_TARGET=                     # E.164 number, for the WhatsApp fallback
# OPENCLAW_ACCOUNTS_DIR=/root/.openclaw/openclaw-weixin/accounts
